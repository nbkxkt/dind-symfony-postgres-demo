{% extends 'base.html.twig' %}

{% block body %}
<section class="card">
    <span class="badge">Lecture PostgreSQL · réseau interne</span>
    <h1>Démonstration Symfony dans le DIND automatique</h1>
    <p class="intro">Cette page lit ces exemples depuis PostgreSQL, dans le même Docker imbriqué. La base n’a aucun port publié.</p>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Mesure</th><th>Valeur</th><th>Créée</th></tr></thead>
            <tbody>
            {% for entry in entries %}
                <tr>
                    <td>{{ entry.label }}</td>
                    <td>{{ entry.value }}</td>
                    <td>{{ entry.created_at|date('Y-m-d H:i') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3">Aucune donnée de démonstration.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="foot">Données fictives de démonstration. Aucun accès depuis une route publique n’est configuré.</p>
</section>
{% endblock %}
